{
  "manifest_version": 3,
  "name": "Collapse Tests",
  "version": "1.2.0",
  "description": "Ajoute un filtre Tests dans le menu des filtres de fichiers d'une PR GitHub. Decoche pour replier tous les fichiers .test du diff.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
